---
import Seal from "./Seal.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import { REPO_URL } from "../consts";

interface NavLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  links?: NavLink[];
  tag?: string;
  // Concept nav carries an extra link, so it collapses its text links at a
  // wider breakpoint (820px) than the protocol nav (760px).
  wide?: boolean;
}

const {
  links = [
    { label: "How it works", href: "#how" },
    { label: "Anatomy", href: "#anatomy" },
    { label: "Compare", href: "#compare" },
    { label: "Integrate", href: "#integrate" },
    { label: "Find My ↗", href: "/find-my" },
  ],
  tag,
  wide = false,
} = Astro.props;
---

<nav class={wide ? "wide" : undefined}>
  <div class="nav-inner">
    <a class="brand" href="#top">
      <Seal />
      Sello{tag && <span class="ctag">{tag}</span>}
    </a>
    <div class="nav-links">
      {
        links.map((link) => (
          <a
            class="navlink"
            href={link.href}
            {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
          >
            {link.label}
          </a>
        ))
      }
      <a class="btn btn-ghost" href={REPO_URL} target="_blank" rel="noopener">
        <GitHubIcon />
        GitHub
      </a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklch, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-soft);
  }

  .nav-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 16px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.01em;
  }

  .ctag {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 3px 7px;
    font-weight: 500;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  nav.wide .nav-links {
    gap: 28px;
  }

  .nav-links a.navlink {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-2);
    transition: color 0.18s;
  }

  .nav-links a.navlink:hover {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    nav:not(.wide) .nav-links .navlink {
      display: none;
    }
  }

  @media (max-width: 820px) {
    nav.wide .nav-links .navlink {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .nav-inner {
      padding-left: 22px;
      padding-right: 22px;
    }

    .nav-links {
      gap: 14px;
    }
  }
</style>
