---
import GitHubIcon from "./icons/GitHubIcon.astro";
import { REPO_URL, SPEC_URL } from "../consts";

const commands = [
  { prefix: "node", rest: " --run demo", desc: "local end-to-end demo" },
  { prefix: "node", rest: " --run test", desc: "dependency-free tests" },
  {
    prefix: "node",
    rest: " --run bench -- --json",
    desc: "size & performance",
  },
];
---

<section class="cta">
  <div
    class="bg-grid"
    aria-hidden="true"
    style="-webkit-mask-image: radial-gradient(circle at 50% 50%, black, transparent 60%); mask-image: radial-gradient(circle at 50% 50%, black, transparent 60%); opacity:.4;"
  >
  </div>
  <div class="wrap">
    <span class="eyebrow reveal" style="justify-content:center;"
      >Start here</span
    >
    <h2 class="reveal">Get one verified receipt working end to end.</h2>
    <p class="reveal">
      Skip Rekor, MCP middleware, and CLI polish for now. Land the local loop
      first. Everything else gets easier from there.
    </p>
    <div class="cta-cmds reveal">
      {
        commands.map((cmd) => (
          <div class="cmd">
            <span class="c">
              <span class="p">{cmd.prefix}</span>
              {cmd.rest}
            </span>
            <span class="desc">{cmd.desc}</span>
          </div>
        ))
      }
    </div>
    <div class="cta-btns reveal">
      <a class="btn btn-primary" href={REPO_URL} target="_blank" rel="noopener">
        <GitHubIcon />
        View the repository
      </a>
      <a class="btn btn-ghost" href={SPEC_URL} target="_blank" rel="noopener"
        >Read the spec →</a
      >
    </div>
    <p class="closing reveal">
      Early draft. Issues and pull requests welcome. Adversarial review is the
      point.
    </p>
  </div>
</section>

<style>
  .cta {
    padding: 110px 0 120px;
    text-align: center;
    border-top: 1px solid var(--line-soft);
    position: relative;
  }

  .cta h2 {
    font-size: clamp(30px, 4vw, 50px);
    max-width: 18ch;
    margin: 18px auto 0;
  }

  .cta p {
    color: var(--ink-2);
    margin: 22px auto 0;
    max-width: 50ch;
    font-size: 18px;
  }

  .cta-cmds {
    margin: 40px auto 0;
    max-width: 560px;
    text-align: left;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-2);
    overflow: hidden;
  }

  .cmd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 15px 20px;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .cmd + .cmd {
    border-top: 1px solid var(--line-soft);
  }

  .cmd .c {
    color: var(--ink);
  }

  .cmd .c .p {
    color: var(--accent);
  }

  .cmd .desc {
    color: var(--ink-3);
    font-size: 12px;
    text-align: right;
  }

  .cta-btns {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  .closing {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-3);
    margin-top: 34px;
  }

  @media (max-width: 640px) {
    .cta {
      padding: 72px 0 84px;
    }
  }
</style>
