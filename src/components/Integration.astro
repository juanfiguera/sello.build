---
const serviceSteps = [
  "Verify the agent's token.",
  "Read <code>owner_hpke_pk</code> and <code>sello_logs</code> from it.",
  "Build a CBOR body for the action.",
  "Encrypt it to the owner with HPKE.",
  "Sign the COSE_Sign1 envelope.",
  "Publish to a trusted log.",
];

const ownerSteps = [
  "Query trusted logs by <code>sello_token_ref</code>.",
  "Confirm the <code>sello_log_url</code> matches.",
  "Verify log inclusion.",
  "Resolve the signing key from <code>kid</code>.",
  "Verify the COSE signature.",
  "Decrypt and display the body.",
];
---

<section class="sec" id="integrate">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Integration</span>
      <h2>Two sides. Both drop in as middleware.</h2>
    </div>

    <div class="bridge">
      <div class="col col-card reveal">
        <h3><span class="tag">Service</span> Emit a receipt</h3>
        <p class="sub">Wraps an existing request handler.</p>
        <ol class="steps">
          {
            serviceSteps.map((step) => (
              <li>
                <span class="st" set:html={step} />
              </li>
            ))
          }
        </ol>
      </div>

      <div class="spine" aria-hidden="true">
        <span class="spine-rail"></span>
        <span class="spine-node"><span class="sn-ico"></span>log</span>
      </div>

      <div class="col col-card reveal">
        <h3><span class="tag">Owner</span> Verify a receipt</h3>
        <p class="sub">A pull-based audit tool.</p>
        <ol class="steps">
          {
            ownerSteps.map((step) => (
              <li>
                <span class="st" set:html={step} />
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .bridge {
    display: grid;
    grid-template-columns: 1fr 88px 1fr;
    align-items: stretch;
  }

  .col-card {
    border: 1px solid var(--line-soft);
    background: var(--bg-2);
    border-radius: 14px;
    padding: 30px 28px;
  }

  .spine {
    position: relative;
    display: grid;
    place-items: center;
  }

  .spine-rail {
    position: absolute;
    top: 50%;
    left: -1px;
    right: -1px;
    height: 1px;
    transform: translateY(-50%);
    background: linear-gradient(
      90deg,
      var(--line),
      var(--accent-dim),
      var(--line)
    );
  }

  .spine::before,
  .spine::after {
    content: "\25B8";
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent-dim);
    font-size: 11px;
  }

  .spine::before {
    left: 4px;
  }

  .spine::after {
    right: 4px;
  }

  .spine-node {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    background: var(--bg);
    padding: 10px 6px;
    border-radius: 8px;
  }

  .sn-ico {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    border: 1.5px solid var(--accent-dim);
    position: relative;
  }

  .sn-ico::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
  }

  .col h3 {
    font-size: 22px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .col h3 .tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    border-radius: 5px;
    padding: 3px 8px;
    font-weight: 500;
  }

  .col .sub {
    color: var(--ink-3);
    font-size: 14px;
    margin-top: 8px;
  }

  .steps {
    list-style: none;
    counter-reset: s;
    margin-top: 24px;
  }

  .steps li {
    position: relative;
    padding: 0 0 18px 44px;
    counter-increment: s;
  }

  .steps li::before {
    content: counter(s, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    font-weight: 600;
  }

  .steps li::after {
    content: "";
    position: absolute;
    left: 9px;
    top: 20px;
    bottom: 2px;
    width: 1px;
    background: var(--line-soft);
  }

  .steps li:last-child::after {
    display: none;
  }

  .steps li .st {
    font-size: 14.5px;
    color: var(--ink);
  }

  .steps li .st :global(code) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent);
    background: var(--accent-bg);
    padding: 1px 6px;
    border-radius: 4px;
  }

  @media (max-width: 720px) {
    .bridge {
      grid-template-columns: 1fr;
    }

    .spine {
      height: 64px;
    }

    .spine-rail {
      top: -1px;
      bottom: -1px;
      left: 50%;
      right: auto;
      width: 1px;
      height: auto;
      transform: translateX(-50%);
      background: linear-gradient(
        180deg,
        var(--line),
        var(--accent-dim),
        var(--line)
      );
    }

    .spine::before,
    .spine::after {
      display: none;
    }
  }
</style>
