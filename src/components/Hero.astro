---
import GitHubIcon from "./icons/GitHubIcon.astro";
import { REPO_URL } from "../consts";

// Each entry is one line of the syntax-highlighted receipt. Rendered as a
// block with `white-space: pre`, so the leading indentation is preserved
// without depending on source whitespace.
const receiptLines = [
  "{",
  '  <span class="k">"service"</span>: <span class="s">"example.com/tool/v1"</span>,',
  '  <span class="k">"action-type"</span>: <span class="s">"tools/call"</span>,',
  '  <span class="k">"result-status"</span>: <span class="s">"success"</span>,',
  '  <span class="k">"verified"</span>: <span class="true">true</span>',
  "}",
];
---

<span id="top"></span>
<header class="hero">
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <span class="eyebrow">Protocol draft · v0.1</span>
        <h1>
          Receipts for what your agents <span class="hl">actually did.</span>
        </h1>
        <p class="lead">
          The services your agent calls sign an encrypted receipt for what they
          observed and publish it to a transparency log. Later, you verify it
          with your own key. No trust in the agent's own logs required.
        </p>
        <div class="pron">
          <span>/SEH-yoh/</span><span class="sep">·</span><span
            >Spanish for <b>&ldquo;seal&rdquo; or &ldquo;stamp&rdquo;</b></span
          >
        </div>
        <div class="hero-cta">
          <a
            class="btn btn-primary"
            href={REPO_URL}
            target="_blank"
            rel="noopener"
          >
            <GitHubIcon />
            View on GitHub
          </a>
          <a class="btn btn-ghost" href="#how">See how it works</a>
        </div>
      </div>

      <div>
        <div class="receipt" id="receiptCard">
          <div class="receipt-head">
            <span class="dot"></span><span class="dot"></span><span class="dot"
            ></span>
            <span class="title">verified-receipt.json</span>
          </div>
          <div class="receipt-body">
            {
              receiptLines.map((line, i) => (
                <span
                  class="rline"
                  style={`animation-delay:${((i + 1) * 0.15).toFixed(2)}s`}
                  set:html={line}
                />
              ))
            }
          </div>
          <div class="receipt-stamp" aria-hidden="true">
            <span><span class="chk">✓</span>Sello<br />verified</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    padding: 110px 0 90px;
    position: relative;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(36px, 5.4vw, 66px);
    margin: 26px 0 0;
    max-width: 14ch;
  }

  .hero h1 .hl {
    color: var(--accent);
  }

  .hero p.lead {
    font-size: 19px;
    color: var(--ink-2);
    margin-top: 26px;
    max-width: 52ch;
  }

  .pron {
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-3);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    padding: 6px 14px;
  }

  .pron b {
    color: var(--accent);
    font-weight: 500;
  }

  .pron .sep {
    color: var(--line);
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  /* receipt card */
  .receipt {
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg-2) 100%);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: visible;
    box-shadow:
      0 30px 80px -30px rgba(0, 0, 0, 0.7),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset;
    position: relative;
  }

  .receipt-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 13px 16px;
    border-bottom: 1px solid var(--line-soft);
    border-radius: 14px 14px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-3);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }

  .receipt-head .title {
    margin-left: 6px;
    letter-spacing: 0.04em;
  }

  .receipt-body {
    padding: 24px 22px 30px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.85;
  }

  .receipt-body .k {
    color: var(--ink-3);
  }

  .receipt-body .s {
    color: oklch(0.82 0.09 200);
  }

  .receipt-body .true {
    color: var(--accent);
  }

  .receipt-stamp {
    position: absolute;
    right: -22px;
    top: -22px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    display: grid;
    place-items: center;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transform: rotate(-12deg);
    box-shadow:
      0 0 0 5px var(--bg),
      0 0 0 6px var(--accent-bg);
    background: var(--bg-2);
    opacity: 0;
    animation: stampIn 0.6s 1.1s cubic-bezier(0.2, 1.4, 0.4, 1) forwards;
  }

  .receipt-stamp .chk {
    font-size: 18px;
    display: block;
    line-height: 1;
    margin-bottom: 3px;
  }

  @keyframes stampIn {
    0% {
      opacity: 0;
      transform: rotate(-12deg) scale(1.8);
    }
    100% {
      opacity: 1;
      transform: rotate(-12deg) scale(1);
    }
  }

  .rline {
    display: block;
    white-space: pre;
    opacity: 0;
    transform: translateY(4px);
    animation: rlineIn 0.4s forwards;
  }

  @keyframes rlineIn {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 940px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 64px 0 56px;
    }

    .hero p.lead {
      font-size: 17px;
    }

    .receipt-stamp {
      width: 62px;
      height: 62px;
      top: -16px;
      right: -14px;
      font-size: 7px;
    }

    .receipt-stamp .chk {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .receipt-stamp,
    .rline {
      animation: none;
      opacity: 1;
      transform: rotate(-12deg);
    }

    .rline {
      transform: none;
    }
  }
</style>
